prebuilt_etc {
    name: "pixel_charger_battery_fail_vendor",
    filename: "battery_fail.png",
    src: "images/battery_fail.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_battery_overheat_vendor",
    filename: "battery_overheat.png",
    src: "images/battery_overheat.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_battery_scale_vendor",
    filename: "battery_scale.png",
    src: "images/battery_scale.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_font_vendor",
    filename: "main_font.png",
    src: "images/main_font.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_animation_vendor",
    filename: "animation.txt",

    required: [
        "pixel_charger_battery_fail_vendor",
        "pixel_charger_battery_overheat_vendor",
        "pixel_charger_battery_scale_vendor",
        "pixel_charger_font_vendor",
    ],
    src: "animation.txt",
    relative_install_path: "res/values/charger",
    proprietary: true,
}
